    "@types/node": "^22.20.5",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.14.0",
    "rollup": "^4.34.8",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0"
